{
  "name": "ref-tauri-react-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Reference implementation for the VibeCode QA Tauri React Desktop standard.",
  "license": "MIT",
  "packageManager": "pnpm@10.33.3",
  "repository": {
    "type": "git",
    "url": "https://github.com/vibecodeqa/ref-tauri-react-desktop.git"
  },
  "engines": {
    "node": ">=22 <27",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "build": "vite build",
    "build:preview": "vite build --mode preview",
    "dev": "vite",
    "lint": "biome check .",
    "format": "biome format --write .",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "validate:desktop": "node scripts/validate-desktop-config.mjs",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "vcqa": "npx @vibecodeqa/cli --markdown"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@vitejs/plugin-react": "^6.0.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite": "^8.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}

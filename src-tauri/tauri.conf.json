{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reference Tauri React Desktop",
  "version": "0.1.0",
  "identifier": "online.vibecodeqa.ref-tauri-react-desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:5202",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Reference Tauri React Desktop",
        "width": 900,
        "height": 660,
        "minWidth": 560,
        "minHeight": 420,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-ancestors 'none'",
      "freezePrototype": true,
      "assetProtocol": {
        "enable": false,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": ["deb", "app", "msi"],
    "category": "DeveloperTool",
    "shortDescription": "VibeCode QA Tauri React Desktop reference",
    "longDescription": "Product-neutral reference implementation of the VibeCode QA Tauri React Desktop standard: a narrow, validated Rust command surface behind a Vite + React + TypeScript frontend.",
    "copyright": "Copyright (c) 2026 VibeCode QA",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
